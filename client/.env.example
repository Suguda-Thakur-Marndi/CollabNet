# CollabNet Client — Environment Variables
# Copy to .env and fill in values. NEVER put secrets here.

# URL of the backend server (Socket.IO + API)
VITE_BACKEND_URL=http://localhost:3000

# Optional: self-hosted Piston code execution API
# Leave blank to use the public Piston API (https://emkc.org/api/v2/piston)
VITE_PISTON_API_URL=
