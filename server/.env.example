# ============================================================
# CollabNet Server — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Application
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_32_CHARS

# Google Gemini AI — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database (PostgreSQL) — leave empty for in-memory dev mode
DATABASE_URL=

# Redis — leave empty for in-memory fallback (single-instance dev)
REDIS_URL=

# EC2 Execution Worker — leave empty to use local PTY
EXECUTION_WORKER_URL=
EXECUTION_WORKER_SECRET=

# WebRTC TURN Server — leave empty for STUN-only
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# AWS S3 (optional)
S3_BUCKET_NAME=
AWS_REGION=us-east-1
